<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Current_Programs</name>
        <label>Append_Current_Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>out_Programs_List</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Program_Summary_Line</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_Over_Program_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Active_Programs_Output</name>
        <label>Set Active Programs Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>out_Has_Active_Programs</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_No_Active_Programs_Message</name>
        <label>Set No Active Programs Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>out_Programs_List</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>No active training programs are currently available.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Active_Programs_Exist</name>
        <label>Check If Active Programs Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_No_Active_Programs_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No_Programs</defaultConnectorLabel>
        <rules>
            <name>Has_Programs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Retrieve_Current_Program_List</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_Over_Program_List</targetReference>
            </connector>
            <label>Has_Programs</label>
        </rules>
    </decisions>
    <description>Retrieves active training programs (Is_Active__c = True) from Training_Program__c, returning program name, credential type, duration, and program code to Agentforce, or indicating when no active programs are available.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>Program_Summary_Line</name>
        <dataType>String</dataType>
        <expression>{!Iterate_Over_Program_List.Name} &amp; &quot; (&quot; &amp; {!Iterate_Over_Program_List.Program_Code__c} &amp; &quot;) - &quot; &amp; TEXT({!Iterate_Over_Program_List.Credential_Type__c}) &amp; &quot; - &quot; &amp; IF(ISBLANK({!Iterate_Over_Program_List.Duration_Weeks__c}), &quot;Duration TBD&quot;, TEXT({!Iterate_Over_Program_List.Duration_Weeks__c}) &amp; &quot; weeks&quot;)</expression>
    </formulas>
    <interviewLabel>Get Active Training Programs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Active Training Programs</label>
    <loops>
        <name>Iterate_Over_Program_List</name>
        <label>Iterate_Over_Program_List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Retrieve_Current_Program_List</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Current_Programs</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Active_Programs_Output</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Retrieve_Current_Program_List</name>
        <label>Retrieve Current Program List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Active_Programs_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>8.0</numberValue>
        </limit>
        <object>Training_Program__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Credential_Type__c</queriedFields>
        <queriedFields>Duration_Weeks__c</queriedFields>
        <queriedFields>Program_Code__c</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Retrieve_Current_Program_List</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Dummy variable for agentforce</description>
        <name>AddanUnusedInputVariabletoYourFlow</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>out_Has_Active_Programs</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>out_Programs_List</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
