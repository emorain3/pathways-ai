    <environments>Default</environments>
    <formulas>
        <name>Has_Required_Requester_Info</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK(TRIM({!in_Requester_Name}))),
  NOT(ISBLANK(TRIM({!in_Requester_Email})))
)</expression>
    </formulas>
    <formulas>
        <name>Is_Valid_Topic_Category</name>
        <dataType>Boolean</dataType>
        <expression>CASE(TRIM({!in_Topic_Category}), &quot;Admissions&quot;, 1, &quot;Program Eligibility&quot;, 1, &quot;Documents &amp; Application&quot;, 1, &quot;Financial Aid / Stipends&quot;, 1, &quot;General Inquiry&quot;, 1, 0) = 1</expression>
    </formulas>
